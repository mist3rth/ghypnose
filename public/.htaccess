# ==============================================================================
# CONFIGURATION APACHE / OVHCLOUD MUTUALISÉ - GHYPNOSE
# ==============================================================================

# Sécurité générale
Options -Indexes
ServerSignature Off

# Page d'erreur 404 personnalisée (Servie avec code HTTP 404 strict)
ErrorDocument 404 /404.html

# ==============================================================================
# EN-TÊTES DE SÉCURITÉ HTTP (Objectif SecurityHeaders.com : Note A+)
# ==============================================================================
<IfModule mod_headers.c>
  # HSTS (Strict-Transport-Security) : 1 an, sous-domaines et preload inclus
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Protection contre le MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Protection contre le Clickjacking (iframe)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Politique de Referrer moderne et respectueuse de la vie privée
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy : Désactive les accès matériels non utilisés
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

  # Content Security Policy (CSP) : Robuste contre XSS, compatible GAS contact form
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https://script.google.com https://script.googleusercontent.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://script.google.com;"

  # Nettoyage des signatures
  Header unset X-Powered-By
</IfModule>

# ==============================================================================
# RÈGLES DE RÉÉCRITURE D'URL (mod_rewrite)
# ==============================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Forcer HTTPS et domaine canonique https://www.ghypnose.fr
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^ghypnose\.fr$ [NC]
  RewriteRule ^(.*)$ https://www.ghypnose.fr/$1 [L,R=301]

  # 2. Redirections 301 permanentes des anciens slugs vers les nouveaux (Option B)
  RewriteRule ^specialites/arret-tabac/?$ /hypnose-arret-tabac-paris [R=301,L]
  RewriteRule ^specialites/stress-anxiete/?$ /hypnose-stress-anxiete-paris [R=301,L]
  RewriteRule ^specialites/troubles-sommeil/?$ /hypnose-sommeil-insomnie-paris [R=301,L]
  RewriteRule ^specialites/confiance-en-soi/?$ /hypnose-confiance-en-soi-paris [R=301,L]

  # 3. Interdire l'accès direct en code 200 à /404 ou 404.html (Résolution alerte GSC)
  RewriteCond %{THE_REQUEST} /404(\.html)?(\s|\?) [NC]
  RewriteRule ^ - [R=404,L]

  # 4. Suppression des trailing slashes pour les URLs non répertoires
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ /$1 [L,R=301]

  # 5. Laisser passer les fichiers et dossiers existants réels
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 6. Réécriture transparente vers le fichier .html correspondant
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# ==============================================================================
# COMPRESSION GZIP / DEFLATE
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ==============================================================================
# MISE EN CACHE DU NAVIGATEUR (Browser Cache)
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
